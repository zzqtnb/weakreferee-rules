[
  {
    "id": "DELETE-ROOT-01",
    "title": "删除的目标是整个盘、家目录或系统目录",
    "when": "tool:pre",
    "appliesTo": {
      "tool": "pwsh",
      "platform": [
        "windows",
        "linux",
        "darwin"
      ]
    },
    "scenarios": [
      "bulk-delete"
    ],
    "condition": {
      "all": [
        {
          "type": "regexHit",
          "in": "args.command",
          "maskQuoted": false,
          "pattern": "\\b(Remove-Item|ri|del|erase|rd|rmdir)\\b[^\\n|;]*?(?:[A-Za-z]:[\\\\/]{1,2}(?![\\w.\\\\/-])|[A-Za-z]:[\\\\/]{1,2}\\*|%(?:USERPROFILE|SystemDrive|HOMEPATH)%|\\$env:(?:USERPROFILE|SystemDrive|HOMEDRIVE)|(?:^|[\\s\"'=(])~[\\\\/]?(?=[\\s\"'),;|]|$)|(?:^|[\\s\"'=(])/[\\\\/]?(?=[\\s\"'),;|]|$))"
        },
        {
          "type": "regexMiss",
          "in": "args.command",
          "maskQuoted": false,
          "pattern": "-WhatIf\\b"
        }
      ]
    },
    "action": "block",
    "severity": "A",
    "message": "要删的是整个盘、整个家目录或系统目录；路径写在引号里也一样",
    "fix": "先 Get-ChildItem 列出要删的清单看一眼，或先加 -WhatIf 干跑；确认范围后改成具体子目录，别从盘根删",
    "reversible": false,
    "limits": "不管三件：① here-string 里的脚本正文同样会被拦（有意为之，因为写完通常会执行）；② 只认盘符根与家目录根，`D:\\data\\*` 这类通配子目录不在此列；③ 未经真实生产调用验证——建议装上后先攒几天自己的日志，确认没有误拦再决定是否保留 block 档，误拦多了就降成 warn 或把具体写法加进本字段。",
    "scene": "AI 拿到「清理磁盘」这类模糊指令时，最容易的错法就是拿盘根或家目录当范围。这条不问删法、只问「删的目标是不是整个盘」，正是为了绕开「路径写在引号里就看不清」这个坑。",
    "evidence": {
      "hits": 0,
      "sessions": 0,
      "source": "真实案例：2026 年 Gemini CLI 一次文件操作清空用户整个 D 盘（8,000+ 文件）；同类可查的还有 2017-05 tenforums 与 2018-12 reddit r/buildapc 的 diskpart 误清分区帖。作者本机命中 0 次，属公共库收录、本机不默认启用"
    },
    "selfTest": {
      "cases": [
      {
        "args": {
          "command": "Remove-Item 'D:\\' -Recurse -Force",
          "description": "t"
        },
        "expect": "block"
      },
      {
        "args": {
          "command": "del D:\\*.* /s /q",
          "description": "t"
        },
        "expect": "block"
      },
      {
        "args": {
          "command": "Remove-Item D:\\ -Recurse",
          "description": "t"
        },
        "expect": "block"
      },
      {
        "args": {
          "command": "Remove-Item $env:USERPROFILE -Recurse",
          "description": "t"
        },
        "expect": "block"
      },
      {
        "args": {
          "command": "Remove-Item \"D:\\*\" -Recurse -Force",
          "description": "t"
        },
        "expect": "block"
      },
      {
        "args": {
          "command": "Remove-Item 'D:\\data\\_tmp\\x' -Recurse -Force",
          "description": "t"
        },
        "expect": "pass"
      },
      {
        "args": {
          "command": "Remove-Item 'D:\\data\\tools\\asr.py' -Force",
          "description": "t"
        },
        "expect": "pass"
      },
      {
        "args": {
          "command": "Remove-Item 'D:\\' -Recurse -WhatIf",
          "description": "t"
        },
        "expect": "pass"
      }
    ]
    },
    "origin": "incident",
    "advisory": "作者本机无此场景，样本为公开事故反推的构造样本，仅供参考；默认启用前请先用自己的常用命令跑一遍 selfTest。"
  },
  {
    "id": "DELETE-UNIX-RF-01",
    "title": "rm 带强制递归，删的是根目录或家目录",
    "when": "tool:pre",
    "appliesTo": {
      "tool": "pwsh",
      "platform": [
        "windows",
        "linux",
        "darwin"
      ]
    },
    "scenarios": [
      "bulk-delete"
    ],
    "condition": {
      "all": [
        {
          "type": "regexHit",
          "in": "args.command",
          "maskQuoted": false,
          "pattern": "\\brm\\b[^|;]*\\s-[A-Za-z]*[rR][A-Za-z]*[fF][A-Za-z]*\\b|\\brm\\b[^|;]*\\s-[A-Za-z]*[fF][A-Za-z]*[rR][A-Za-z]*\\b"
        },
        {
          "type": "regexHit",
          "in": "args.command",
          "maskQuoted": false,
          "pattern": "(?:^|[\\s\"'=])(?:/|~|\\$HOME|/\\*|~\\*|~/\\*)(?=[\\s\"';|)]|$)"
        },
        {
          "type": "regexMiss",
          "in": "args.command",
          "maskQuoted": false,
          "pattern": "--dry-run\\b"
        }
      ]
    },
    "action": "block",
    "severity": "A",
    "message": "rm 带强制递归，删的是根目录或家目录；这类删法没有回收站",
    "fix": "先 ls 或 find 把清单打出来；确实要清就写具体子路径，别用 / 或 ~ 当范围；能加 -i 就先加 -i",
    "reversible": false,
    "limits": "只认 rm 的字母参数组合（-rf/-fr/-Rf 都算），长参数 --recursive --force 也认。不认的是：`find / -delete`、`rsync --delete`、脚本里拼接后才出现的 rm（那类命令文本里没有 rm 字样）",
    "scene": "Unix 上一个字符之差（`rm -rf ~` 少写一个 /）就能清掉整个家目录，且没有回收站。这条把「强制递归」和「根/家目录」两件事绑在一起判，避免把所有 rm -rf 都当危险（删 node_modules、删 dist 是日常操作）。",
    "evidence": {
      "hits": 0,
      "sessions": 0,
      "source": "真实案例：GitLab 2017-01-31 数据库删除事件，运维在 primary 上误跑 rm -rf 删掉数据库目录，事后发现五重备份全部失效（官方事后报告 https://about.gitlab.com/blog/postmortem-of-database-outage-of-january-31/ ）。作者本机命中 0 次"
    },
    "selfTest": {
      "cases": [
        {
          "args": {
            "command": "rm -rf /",
            "description": "删根"
          },
          "expect": "block"
        },
        {
          "args": {
            "command": "rm -rf ~/*",
            "description": "清家目录"
          },
          "expect": "block"
        },
        {
          "args": {
            "command": "rm -rf $HOME",
            "description": "删家目录"
          },
          "expect": "block"
        },
        {
          "args": {
            "command": "rm -rf node_modules",
            "description": "删依赖"
          },
          "expect": "pass"
        },
        {
          "args": {
            "command": "rm -rf ./dist",
            "description": "删产物"
          },
          "expect": "pass"
        }
      ]
    },
    "origin": "incident",
    "advisory": "作者本机无此场景（35,651 次历史调用 0 次命中），样本为公开事故与故障模式反推的构造样本，仅供参考；默认建议先以 warn 档观察一周、确认无误拦再升 block，处置办法见 fix 字段。"
  },
  {
