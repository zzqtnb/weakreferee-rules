[
  {
    "id": "CROSS-RETRY-01",
    "needs": [
      "history"
    ],
    "title": "同一条命令失败过，5 分钟内又原样发一次",
    "when": "tool:pre",
    "appliesTo": {},
    "condition": {
      "type": "failRepeat",
      "key": "command",
      "minutes": 5,
      "times": 1,
      "streak": true
    },
    "action": "warn",
    "severity": "B",
    "message": "这条命令刚刚失败过，一个字的没改就又发了一遍",
    "fix": "先说清上次为什么失败、这次改了什么；确实没得改就说明「只是重试一次」",
    "reversible": true,
    "evidence": {
      "hits": 0,
      "sessions": 0,
      "source": "2026-11-24 四模型实测下常见：命令报错后原样重发，两三次才换思路"
    },
    "selfTest": {
      "cases": [
        {
          "args": {
            "command": "npm run build"
          },
          "history": [
            {
              "tool": "*",
              "args": {
                "command": "npm run build"
              },
              "ok": false,
              "at": 1794999940000
            }
          ],
          "at": 1795000000000,
          "expect": "block",
          "note": "一分钟前同一条命令失败过，这次原样又来"
        },
        {
          "args": {
            "command": "npm run build"
          },
          "at": 1795000000000,
          "expect": "pass",
          "note": "没有历史：显式跳过，不算命中"
        },
        {
          "args": {
            "command": "npm run build"
          },
          "history": [
            {
              "tool": "*",
              "args": {
                "command": "npm run build"
              },
              "ok": true,
              "at": 1794999940000
            }
          ],
          "at": 1795000000000,
          "expect": "pass",
          "note": "上次是成功的，重发不算事"
        }
      ]
    },
    "origin": "model-error"
  },
