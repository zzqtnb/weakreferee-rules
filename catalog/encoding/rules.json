[
  {
    "id": "WIN-ENC-01",
    "title": "写文本文件必须显式指定编码",
    "domain": "encoding",
    "evidence": {
      "level": "实测",
      "hits": 29,
      "sessions": 16,
      "source": "作者环境拦记账本 / 作者环境回放记录"
    },
    "falsePositiveRisk": "low",
    "defaultAction": "block",
    "when": "tool:pre",
    "appliesTo": {
      "tool": "pwsh",
      "platform": [
        "windows"
      ],
      "shell": [
        "powershell-5.1"
      ]
    },
    "condition": {
      "all": [
        {
          "any": [
            {
              "type": "regexHit",
              "in": "args.command",
              "maskQuoted": false,
              "pattern": "(^|[^0-9*>=])>{1,2}\\s*(\"[^\"]+\\.(?:ps1|md|json|txt|csv|log|yml|yaml|xml|ini)\"|'[^']+\\.(?:ps1|md|json|txt|csv|log|yml|yaml|xml|ini)'|[^\\s|;&<>]+\\.(?:ps1|md|json|txt|csv|log|yml|yaml|xml|ini))"
            },
            {
              "type": "regexHit",
              "in": "args.command",
              "maskQuoted": true,
              "pattern": "\\b(Out-File|Set-Content|Add-Content|Export-Csv|Export-Clixml|Tee-Object)\\b"
            }
          ]
        },
        {
          "type": "regexMiss",
          "in": "args.command",
          "maskQuoted": true,
          "pattern": "-Encoding\\b"
        }
      ]
    },
    "message": "写文本文件没带 -Encoding，中文会按默认编码落盘，读回来是乱码",
    "fix": "加 -Encoding utf8，或改用 [System.IO.File]::WriteAllText($p,$s,(New-Object System.Text.UTF8Encoding($true)))",
    "severity": "S",
    "reversible": false,
    "selfTest": {
      "cases": [
        {
          "args": {
            "command": "Out-File -FilePath a.txt"
          },
          "expect": "block"
        },
        {
          "args": {
            "command": "Get-Content a.md > b.md"
          },
          "expect": "block"
        },
        {
          "args": {
            "command": "\"x\" | Set-Content c.json"
          },
          "expect": "block"
        },
        {
          "args": {
            "command": "Out-File -FilePath a.txt -Encoding utf8"
          },
          "expect": "pass"
        },
        {
          "args": {
            "command": "Select-String -Pattern 'Out-File|Set-Content'"
          },
          "expect": "pass"
        },
        {
          "args": {
            "command": "Get-ChildItem | Where-Object { $_.Name -like '*.json' }"
          },
          "expect": "pass"
        }
      ],
      "needFs": false
    },
    "promotedTo": "windows-powershell/WIN-ENC-01"
  },
  {
    "id": "WIN-PS1-CJK-01",
    "title": "write 往 .ps1 写中文正文",
    "domain": "encoding",
    "evidence": {
      "level": "实测",
      "hits": 91,
      "sessions": 33,
      "source": "作者环境拦记账本 / 作者环境回放记录"
    },
    "falsePositiveRisk": "low",
    "defaultAction": "block",
    "when": "tool:pre",
    "appliesTo": {
      "tool": "write",
      "platform": [
        "windows"
      ],
      "fileMatches": "\\.ps1$"
    },
    "condition": {
      "type": "regexHit",
      "in": "args.content",
      "pattern": "[^\\x00-\\x7F]"
    },
    "message": "write 落盘是无 BOM 的 UTF-8，Windows PowerShell 5.1 会按 GBK 解析中文成乱码、报一串假语法错",
    "fix": "改用 pwsh 一次写完：[System.IO.File]::WriteAllText($p,$s,(New-Object System.Text.UTF8Encoding($true)))，同一次调用里回读 [System.IO.File]::ReadAllBytes($p)[0..2] 必须是 239,187,191",
    "severity": "S",
    "reversible": false,
    "selfTest": {
      "cases": [
        {
          "args": {
            "file_path": "a.ps1",
            "content": "写中文"
          },
          "expect": "block"
        },
        {
          "args": {
            "file_path": "a.ps1",
            "content": "ascii only"
          },
          "expect": "pass"
        },
        {
          "args": {
            "file_path": "a.txt",
            "content": "中文"
          },
          "expect": "pass"
        }
      ],
      "needFs": false,
      "note": [
        "原来：write a.ps1 内容含中文",
        "原来：write a.ps1 纯 ASCII 内容",
        "原来：write a.txt 含中文"
      ]
    },
    "promotedTo": "windows-powershell/WIN-PS1-CJK-01"
  },
  {
    "id": "WIN-PS1-BOM-EDIT-01",
    "title": "edit 会去掉 .ps1 的 BOM",
    "domain": "encoding",
    "evidence": {
      "level": "实测",
      "hits": 100,
      "sessions": 17,
      "source": "作者环境拦记账本 / 作者环境回放记录"
    },
    "falsePositiveRisk": "low",
    "defaultAction": "block",
    "when": "tool:pre",
    "appliesTo": {
      "tool": "edit",
      "platform": [
        "windows"
      ],
      "fileMatches": "\\.ps1$"
    },
    "condition": {
      "type": "fileHasBom",
      "key": "file_path"
    },
    "message": "这个 .ps1 带 BOM，edit 落盘会把 BOM 去掉（实测 73→70 字节，纯 ASCII 替换也会）",
    "fix": "改用 pwsh 一次改完：ReadAllText 取全文、替换、WriteAllText 带 UTF8Encoding($true) 写回，并回读前三字节确认 239,187,191",
    "severity": "S",
    "reversible": true,
    "selfTest": {
      "cases": [],
      "needFs": true,
      "note": [
        "需要真实文件：edit 带 BOM 的 a.ps1 应拦；edit 不带 BOM 的 a.ps1 应放行；edit 带 BOM 的 a.md 应放行",
        "由集成测试 _selftest4.js 用临时文件验证"
      ]
    },
    "promotedTo": "windows-powershell/WIN-PS1-BOM-EDIT-01"
  }
]
