[
  {
    "id": "WIN-ENC-01",
    "legacyJudge": "J8",
    "title": "写文本文件必须显式指定编码",
    "when": "tool:pre",
    "appliesTo": {
      "tool": "pwsh",
      "platform": [
        "windows"
      ],
      "shell": [
        "powershell-5.1"
      ]
    },
    "condition": {
      "all": [
        {
          "any": [
            {
              "type": "regexHit",
              "in": "args.command",
              "maskQuoted": false,
              "pattern": "(^|[^0-9*>=])>{1,2}\\s*(\"[^\"]+\\.(?:ps1|md|json|txt|csv|log|yml|yaml|xml|ini)\"|'[^']+\\.(?:ps1|md|json|txt|csv|log|yml|yaml|xml|ini)'|[^\\s|;&<>]+\\.(?:ps1|md|json|txt|csv|log|yml|yaml|xml|ini))"
            },
            {
              "type": "regexHit",
              "in": "args.command",
              "maskQuoted": true,
              "pattern": "\\b(Out-File|Set-Content|Add-Content|Export-Csv|Export-Clixml|Tee-Object)\\b"
            }
          ]
        },
        {
          "type": "regexMiss",
          "in": "args.command",
          "maskQuoted": true,
          "pattern": "-Encoding\\b"
        }
      ]
    },
    "action": "block",
    "severity": "S",
    "message": "写文本文件没带 -Encoding，中文会按默认编码落盘，读回来是乱码",
    "fix": "加 -Encoding utf8，或改用 [System.IO.File]::WriteAllText($p,$s,(New-Object System.Text.UTF8Encoding($true)))",
    "reversible": false,
    "evidence": {
      "hits": 29,
      "sessions": 16,
      "source": "作者环境拦记账本 / 作者环境回放记录",
      "whyRaw": "e-m-02：6 天记了 10 条、从未合并"
    },
    "selfTest": {
      "cases": [
        {
          "args": {
            "command": "Out-File -FilePath a.txt"
          },
          "expect": "block"
        },
        {
          "args": {
            "command": "Get-Content a.md > b.md"
          },
          "expect": "block"
        },
        {
          "args": {
            "command": "\"x\" | Set-Content c.json"
          },
          "expect": "block"
        },
        {
          "args": {
            "command": "Out-File -FilePath a.txt -Encoding utf8"
          },
          "expect": "pass"
        },
        {
          "args": {
            "command": "Select-String -Pattern 'Out-File|Set-Content'"
          },
          "expect": "pass"
        },
        {
          "args": {
            "command": "Get-ChildItem | Where-Object { $_.Name -like '*.json' }"
          },
          "expect": "pass"
        }
      ],
      "needFs": false
    },
    "scene": "导出文本时没写编码，中文落盘变成问号或乱码；当时看着成功，隔天再读才发现内容毁了。"
  },
  {
    "id": "WIN-AUTOVAR-CMD-01",
    "legacyJudge": "J17",
    "title": "命令行里不许给 PowerShell 自动变量赋值",
    "when": "tool:pre",
    "appliesTo": {
      "tool": "pwsh",
      "platform": [
        "windows"
      ],
      "shell": [
        "powershell-5.1"
      ]
    },
    "condition": {
      "type": "regexHit",
      "in": "args.command",
      "maskQuoted": true,
      "pattern": "\\$(input|args|error|host|home|pid|matches|this|foreach|psitem)\\s*=(?!=)"
    },
    "action": "block",
    "severity": "S",
    "message": "给 PowerShell 自动变量赋值（只读，或影响解析）",
    "fix": "换带固定前缀的多字名，如 $envPath 而不是 $home",
    "reversible": false,
    "evidence": {
      "hits": 12,
      "sessions": 11,
      "source": "作者环境拦记账本（累计命中见 hits）"
    },
    "selfTest": {
      "cases": [
        {
          "args": {
            "command": "$home = 'D:\\x'"
          },
          "expect": "block"
        },
        {
          "args": {
            "command": "$args = 1"
          },
          "expect": "block"
        },
        {
          "args": {
            "command": "$envPath = 'D:\\x'"
          },
          "expect": "pass"
        },
        {
          "args": {
            "command": "Write-Output '$home = 1'"
          },
          "expect": "pass"
        }
      ],
      "needFs": false
    },
    "scene": "命令行里给 $home 这类保留名赋值，整条命令当场失效，报错信息完全看不出跟赋值有关，来回改别的部分浪费很久。"
  },
  {
    "id": "WIN-PS1-AUTOVAR-01",
    "legacyJudge": "J10",
    "title": "往 .ps1 里写自动变量赋值",
    "when": "tool:pre",
    "appliesTo": {
      "tools": [
        "write",
        "edit"
      ],
      "platform": [
        "windows"
      ],
      "fileMatches": "\\.ps1$"
    },
    "condition": {
      "any": [
        {
          "type": "regexHit",
          "in": "args.content",
          "pattern": "\\$(input|args|error|host|home|pid|matches|this|foreach|psitem)\\s*=(?!=)"
        },
        {
          "type": "regexHit",
          "in": "args.new_string",
          "pattern": "\\$(input|args|error|host|home|pid|matches|this|foreach|psitem)\\s*=(?!=)"
        }
      ]
    },
    "action": "block",
    "severity": "S",
    "message": "往 .ps1 里写了 PowerShell 自动变量赋值（只读或影响解析）",
    "fix": "换个带前缀的多字名，如 $envPath",
    "reversible": false,
    "evidence": {
      "hits": 1,
      "sessions": 1,
      "source": "作者环境拦记账本（累计命中见 hits）"
    },
    "selfTest": {
      "cases": [
        {
          "args": {
            "file_path": "a.ps1",
            "content": "$home = 'D:\\x'"
          },
          "expect": "block"
        },
        {
          "args": {
            "file_path": "a.txt",
            "content": "$home = 1"
          },
          "expect": "pass"
        },
        {
          "args": {
            "file_path": "b.ps1",
            "content": "$envPath = 1"
          },
          "expect": "pass"
        }
      ],
      "needFs": false,
      "note": [
        "原来：write a.ps1 内容含 $home = 'D:\\x'",
        "原来：write a.txt 内容含 $home = 1（不是 .ps1）"
      ]
    },
    "scene": "脚本里给保留名赋值，一运行就报只读；改了半天别的行，最后才发现撞的是内建变量。"
  },
  {
    "id": "WIN-PS1-CJK-01",
    "legacyJudge": "J15",
    "title": "write 往 .ps1 写中文正文",
    "when": "tool:pre",
    "appliesTo": {
      "tool": "write",
      "platform": [
        "windows"
      ],
      "fileMatches": "\\.ps1$"
    },
    "condition": {
      "type": "regexHit",
      "in": "args.content",
      "pattern": "[^\\x00-\\x7F]"
    },
    "action": "block",
    "severity": "S",
    "message": "write 落盘是无 BOM 的 UTF-8，Windows PowerShell 5.1 会按 GBK 解析中文成乱码、报一串假语法错",
    "fix": "改用 pwsh 一次写完：[System.IO.File]::WriteAllText($p,$s,(New-Object System.Text.UTF8Encoding($true)))，同一次调用里回读 [System.IO.File]::ReadAllBytes($p)[0..2] 必须是 239,187,191",
    "reversible": false,
    "evidence": {
      "hits": 91,
      "sessions": 33,
      "source": "作者环境拦记账本 / 作者环境回放记录"
    },
    "selfTest": {
      "cases": [
        {
          "args": {
            "file_path": "a.ps1",
            "content": "写中文"
          },
          "expect": "block"
        },
        {
          "args": {
            "file_path": "a.ps1",
            "content": "ascii only"
          },
          "expect": "pass"
        },
        {
          "args": {
            "file_path": "a.txt",
            "content": "中文"
          },
          "expect": "pass"
        }
      ],
      "needFs": false,
      "note": [
        "原来：write a.ps1 内容含中文",
        "原来：write a.ps1 纯 ASCII 内容",
        "原来：write a.txt 含中文"
      ]
    },
    "scene": "脚本里写了中文注释或中文字符串，落盘后被按本地代码页读成乱码，机器报出一串假的语法错误，人以为是代码逻辑写错。"
  },
  {
    "id": "WIN-PS1-BOM-EDIT-01",
    "legacyJudge": "J16",
    "title": "edit 会去掉 .ps1 的 BOM",
    "when": "tool:pre",
    "appliesTo": {
      "tool": "edit",
      "platform": [
        "windows"
      ],
      "fileMatches": "\\.ps1$"
    },
    "condition": {
      "type": "fileHasBom",
      "key": "file_path"
    },
    "action": "block",
    "severity": "S",
    "message": "这个 .ps1 带 BOM，edit 落盘会把 BOM 去掉（实测 73→70 字节，纯 ASCII 替换也会）",
    "fix": "改用 pwsh 一次改完：ReadAllText 取全文、替换、WriteAllText 带 UTF8Encoding($true) 写回，并回读前三字节确认 239,187,191",
    "reversible": true,
    "evidence": {
      "hits": 100,
      "sessions": 17,
      "source": "作者环境拦记账本 / 作者环境回放记录"
    },
    "selfTest": {
      "cases": [],
      "needFs": true,
      "note": [
        "需要真实文件：edit 带 BOM 的 a.ps1 应拦；edit 不带 BOM 的 a.ps1 应放行；edit 带 BOM 的 a.md 应放行",
        "由集成测试 _selftest4.js 用临时文件验证"
      ]
    },
    "scene": "带 BOM 的脚本被普通编辑器改了一次，BOM 悄悄没了；之后运行时中文全乱，从现象上完全看不出是「编辑」这一步造成的。"
  },
  {
