      "in": "args.command",
      "maskQuoted": true,
      "pattern": "\\b(reg\\s+(add|delete|import)|New-Service|Set-Service|Remove-Service|Register-ScheduledTask|Unregister-ScheduledTask|Format-Volume|Initialize-Disk|Clear-Disk|vssadmin|wbadmin)\\b|\\bsc(\\.exe)?\\s+(create|delete|config)\\b|\\bschtasks(\\.exe)?\\s+/(create|delete)\\b|\\bnetsh\\s+(int|advfirewall|winsock)\\s+\\w+\\s+(set|reset|delete)\\b|\\bdiskpart\\b"
    },
    "action": "warn",
    "severity": "A",
    "message": "不可逆动作（改注册表/服务/计划任务/磁盘/网络配置），rewind 与回收站都救不回",
    "fix": "先导出回滚材料（reg export / 服务定义 / 任务 XML），再执行",
    "reversible": false,
    "evidence": {
      "hits": 0,
      "sessions": 0,
      "source": "影子期，尚未拦过"
    },
    "selfTest": {
      "cases": [
        {
          "args": {
