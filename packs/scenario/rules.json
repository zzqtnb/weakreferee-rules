        {
          "type": "regexHit",
          "in": "args.command",
          "maskQuoted": false,
          "pattern": "[Pp][Rr][Oo][Dd]([Uu][Cc][Tt][Ii][Oo][Nn])?|[Ll][Ii][Vv][Ee]|[Pp][Rr][Dd]"
