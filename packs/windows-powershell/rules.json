          "type": "regexHit",
          "in": "args.content",
          "pattern": "\\$(input|args|error|host|home|pid|matches|this|foreach|psitem)\\s*=(?!=)"
        },
        {
          "type": "regexHit",
          "in": "args.new_string",
          "pattern": "\\$(input|args|error|host|home|pid|matches|this|foreach|psitem)\\s*=(?!=)"
        }
      ]
    },
    "action": "block",
    "severity": "S",
    "message": "往 .ps1 里写了 PowerShell 自动变量赋值（只读或影响解析）",
    "fix": "换个带前缀的多字名，如 $envPath",
    "reversible": false,
    "evidence": {
      "hits": 1,
      "sessions": 1,
      "source": "作者环境拦记账本（累计命中见 hits）"
    },
    "selfTest": {
      "cases": [
        {
          "args": {
            "file_path": "a.ps1",
            "content": "$home = 'D:\\x'"
          },
          "expect": "block"
        },
        {
          "args": {
            "file_path": "a.txt",
            "content": "$home = 1"
          },
          "expect": "pass"
        },
        {
          "args": {
            "file_path": "b.ps1",
            "content": "$envPath = 1"
          },
          "expect": "pass"
        }
      ],
      "needFs": false,
      "note": [
        "原来：write a.ps1 内容含 $home = 'D:\\x'",
        "原来：write a.txt 内容含 $home = 1（不是 .ps1）"
      ]
    },
    "scene": "脚本里给保留名赋值，一运行就报只读；改了半天别的行，最后才发现撞的是内建变量。"
  },
  {
