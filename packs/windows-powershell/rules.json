      "sessions": 33,
      "source": "作者环境拦记账本 / 作者环境回放记录"
    },
    "selfTest": {
      "cases": [
        {
          "args": {
            "file_path": "a.ps1",
            "content": "写中文"
          },
          "expect": "block"
        },
        {
          "args": {
            "file_path": "a.ps1",
            "content": "ascii only"
          },
          "expect": "pass"
        },
        {
          "args": {
            "file_path": "a.txt",
            "content": "中文"
          },
          "expect": "pass"
        }
      ],
      "needFs": false,
      "note": [
        "原来：write a.ps1 内容含中文",
        "原来：write a.ps1 纯 ASCII 内容",
        "原来：write a.txt 含中文"
      ]
    },
    "scene": "脚本里写了中文注释或中文字符串，落盘后被按本地代码页读成乱码，机器报出一串假的语法错误，人以为是代码逻辑写错。"
  },
  {
