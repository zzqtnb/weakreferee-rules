            "command": "robocopy D:\\a D:\\b /MIR"
          },
          "expect": "block"
        },
        {
          "args": {
            "command": "robocopy D:\\a D:\\b /E"
          },
          "expect": "pass"
        },
        {
          "args": {
            "command": "Write-Output 'robocopy D:\\a D:\\b /MIR'"
          },
          "expect": "pass"
        }
      ],
      "needFs": false
    },
    "scene": "整目录复制或清理时没注意里面有一个指向别处的联接，跟随下去把链接那头的真实文件一起清掉了；删的是「快捷方式」，没的是原件。"
  },
