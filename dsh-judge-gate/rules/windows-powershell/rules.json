            "command": "sc delete SomeService"
          },
          "expect": "block"
        },
        {
          "args": {
            "command": "Get-Service"
          },
          "expect": "pass"
        },
        {
          "args": {
            "command": "reg query HKCU\\Software"
          },
          "expect": "pass"
        }
      ],
      "needFs": false
    },
    "scene": "改注册表、服务或计划任务之前没有导出旧配置，出问题只能靠回忆往回改，改错一处就再也回不到原样。"
  },
  {
    "id": "WIN-MIRROR-01",
    "legacyJudge": "J11",
    "title": "整目录镜像前先查目录联接",
    "when": "tool:pre",
    "appliesTo": {
      "tool": "pwsh",
      "platform": [
        "windows"
      ]
    },
    "condition": {
      "type": "regexHit",
      "in": "args.command",
      "maskQuoted": true,
      "pattern": "(?:^|[\\r\\n;|&({])\\s*(?:&|\\.\\s+)?robocopy\\b[^|;\\r\\n]*/(MIR|PURGE)\\b"
    },
    "action": "warn",
    "severity": "A",
    "message": "整目录镜像/清理未先查目录联接：robocopy 跟随 junction，镜像一个含联接的目录等于清空链接目标",
    "fix": "先 Get-ChildItem -Force 看目标里有没有 ReparsePoint，有就只删链接不动内容",
    "reversible": false,
    "evidence": {
      "hits": 0,
      "sessions": 0,
      "source": "作者环境实测会话：跟随式复制把 junction 指向的真实源码一并清空，30 秒清掉三个插件"
    },
    "selfTest": {
      "cases": [
        {
          "args": {
            "command": "robocopy D:\\a D:\\b /MIR"
          },
          "expect": "block"
        },
        {
          "args": {
            "command": "robocopy D:\\a D:\\b /E"
          },
          "expect": "pass"
        },
        {
          "args": {
            "command": "Write-Output 'robocopy D:\\a D:\\b /MIR'"
          },
          "expect": "pass"
        }
      ],
      "needFs": false
    },
    "scene": "整目录复制或清理时没注意里面有一个指向别处的联接，跟随下去把链接那头的真实文件一起清掉了；删的是「快捷方式」，没的是原件。"
  },
  {
    "id": "WIN-BAT-CJK-01",
    "legacyJudge": "mine",
    "title": "write 往 .bat/.cmd 写中文正文",
    "when": "tool:pre",
    "appliesTo": {
      "tool": "write",
      "platform": [
        "windows"
      ],
      "fileMatches": "\\.(bat|cmd)$"
    },
    "condition": {
      "type": "regexHit",
      "in": "args.content",
      "pattern": "[^\\x00-\\x7F]"
    },
    "action": "warn",
    "severity": "S",
    "message": "批处理文件按本地代码页解析（中文系统是 GBK），写进去的中文会变乱码，或者让 cmd 读到一半报错",
    "fix": "批处理里只写 ASCII；必须输出中文时，在文件开头加 chcp 65001，并让 bat 用 type 输出一个外部 UTF-8 文本文件",
    "reversible": true,
    "evidence": {
      "hits": 9,
      "sessions": 4,
      "source": "mine：作者环境 195 个会话、20,107 次调用里统计到 9 次（write 调用 1,107 次）"
    },
    "selfTest": {
      "cases": [
        {
          "args": {
            "file_path": "a.bat",
            "content": "echo 中文"
          },
          "expect": "block"
        },
        {
          "args": {
            "file_path": "a.bat",
            "content": "echo hello"
          },
          "expect": "pass"
        },
        {
          "args": {
            "file_path": "a.txt",
            "content": "中文"
          },
          "expect": "pass"
        }
      ],
      "needFs": false,
      "note": [
        "原来：write a.bat 含中文",
        "原来：write a.bat 纯 ASCII",
        "原来：write a.txt 含中文（.txt 不归它管）"
      ]
    },
    "scene": "批处理里写了中文提示，双击运行时显示一串乱码，或者命令解释器读到一半直接停下，人以为是文件坏了。"
  }
]
