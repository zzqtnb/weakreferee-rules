[
  {
    "id": "CORE-HTTPS-01",
    "legacyJudge": "J3",
    "title": "web_fetch 只接受 https",
    "when": "tool:pre",
    "appliesTo": {
      "tool": "web_fetch"
    },
    "condition": {
      "any": [
        {
          "type": "regexHit",
          "in": "args.url",
          "pattern": "^http://"
        },
        {
          "type": "regexHit",
          "in": "args.urls",
          "pattern": "^http://"
        }
      ]
    },
    "action": "block",
    "severity": "B",
    "message": "web_fetch 只收 https，http:// 会被工具直接拒绝",
    "fix": "把 http:// 换成 https://",
    "reversible": false,
    "evidence": {
      "hits": 3,
      "sessions": 3,
      "source": "作者环境拦记账本（累计命中见 hits）"
    },
    "selfTest": {
      "cases": [
        {
          "args": {
            "url": "http://example.com"
          },
          "expect": "block"
        },
        {
          "args": {
            "url": "https://example.com"
          },
          "expect": "pass"
        },
        {
          "args": {
            "urls": [
              "http://a.com",
              "https://b.com"
            ]
          },
          "expect": "block"
        }
      ],
      "needFs": false
    },
    "scene": "有人让 AI 去抓一个网页，地址写成明文 http，工具连请求都没发出去就回了失败；来回试了几次，才看出是协议写错。"
  },
  {
    "id": "CORE-PARAMS-GEN",
    "title": "参数形态（由工具契约表编译，不手写）",
    "when": "tool:pre",
    "generator": {
      "kind": "contractTable",
      "emit": [
        "missingKey",
        "emptyValue",
        "missingAnyOf",
        "wrongKey",
        "extraKey",
        "unknownKey",
        "itemUnknownKey"
      ],
      "legacyJudge": "PARAM"
    },
    "action": "block",
    "severity": "B",
    "evidence": {
      "hits": 165,
      "sessions": 45,
      "source": "作者环境拦记账本 / 作者环境回放记录（无规则编号的 165 次）"
    },
    "scene": "调用工具时把参数键名记成另一个相近的词，或者漏掉一个必填键，工具只回一句看不懂的报错；人以为是自己的描述不清楚，其实是参数形态不对。"
  },
  {
    "id": "CORE-ARGTYPE-01",
    "legacyJudge": "J24",
    "title": "参数类型与契约表不符",
    "when": "tool:pre",
    "appliesTo": {
      "tool": "*"
    },
    "condition": {
      "type": "argTypeMismatch"
    },
    "action": "block",
    "severity": "B",
    "message": "参数类型跟工具要求的不一样（表里写 string，你给了数组之类）",
    "fix": "按工具契约改类型：要字符串就传字符串（多个值用逗号连或分多次调用），要整数就别加引号",
    "reversible": false,
    "evidence": {
      "hits": 7,
      "sessions": 2,
      "source": "2026-11-24 回扫 226 个会话、23,523 次真实工具调用：命中 6 次调用 / 7 个键（keywords×2、chapter、hidden、forbidden、participants、updates），逐条看过全是真错，零误报"
    },
    "selfTest": {
      "cases": [
        {
          "tool": "novel_worldbook",
          "args": {
            "keywords": [
              "五行",
              "属性",
              "一人一属"
            ]
          },
          "expect": "block"
        },
        {
          "tool": "novel_outline",
          "args": {
            "chapter": "1"
          },
          "expect": "block"
        },
        {
          "tool": "novel_scene",
          "args": {
            "hidden": []
          },
          "expect": "block"
        },
        {
          "tool": "novel_worldbook",
          "args": {
            "keywords": "五行,属性,一人一属"
          },
          "expect": "pass"
        },
        {
          "tool": "memory_remember",
          "args": {
            "keywords": [
              "a",
              "b"
            ]
          },
          "expect": "pass"
        },
        {
          "tool": "novel_outline",
          "args": {
            "chapter": 1
          },
          "expect": "pass"
        }
      ],
      "needFs": false
    },
    "scene": "给世界书塞关键词时把一串词包成数组传进去，工具照收不误，存下来是一个长字符串；后面按关键词检索，一条都命中不了。"
  },
  {
    "id": "CORE-GIT-FORCE-01",
    "title": "git push 带 --force 会覆盖远端别人的提交",
    "when": "tool:pre",
    "appliesTo": {
      "tool": "pwsh"
    },
    "condition": {
      "all": [
        {
          "type": "regexHit",
          "in": "args.command",
          "maskQuoted": true,
          "pattern": "\\bgit\\s+push\\b"
        },
        {
          "type": "regexHit",
          "in": "args.command",
          "maskQuoted": true,
          "pattern": "(^|\\s)(--force|-f)(\\s|$)"
        },
        {
          "type": "regexMiss",
          "in": "args.command",
          "maskQuoted": true,
          "pattern": "--force-with-lease"
        }
      ]
    },
    "action": "steer",
    "severity": "A",
    "message": "git push 带 --force 会把远端别人的提交直接顶掉，被顶的人下次拉取会丢一批记录",
    "fix": "改用 --force-with-lease：远端要是被别人推过，它会拒绝，不会闷头覆盖",
    "reversible": false,
    "evidence": {
      "hits": 0,
      "sessions": 0,
      "source": "工程经验，作者环境未命中（新规则，未上线）"
    },
    "selfTest": {
      "cases": [
        {
          "args": {
            "command": "git push --force origin main"
          },
          "expect": "block"
        },
        {
          "args": {
            "command": "git push -f"
          },
          "expect": "block"
        },
        {
          "args": {
            "command": "git push --force-with-lease origin main"
          },
          "expect": "pass"
        },
        {
          "args": {
            "command": "git push origin main"
          },
          "expect": "pass"
        }
      ],
      "needFs": false
    },
    "scene": "本机提交历史和远端对不上，一句 git push --force 把远端顶成自己的版本；同事下次拉取时十几条提交消失，得从 reflog 里捞回来。"
  },
  {
    "id": "CORE-PLACEHOLDER-01",
    "title": "交给别人的文件里还留着占位符",
    "when": "tool:pre",
    "appliesTo": {
      "tool": "write",
      "fileMatches": "\\.(md|txt)$"
    },
    "condition": {
      "type": "regexHit",
      "in": "args.content",
      "pattern": "\\[(待补充|待填|请填写|TODO|TBD|XXX)\\]|【(待补充|待填|请填写)】"
    },
    "action": "steer",
    "severity": "B",
    "message": "写进去的内容里带着 [待补充] 这类占位符，交给别人就是一份没写完的东西",
    "fix": "把占位符换成实际内容，或者明确写「此处待定：缺什么、等谁给」",
    "reversible": true,
    "evidence": {
      "hits": 0,
      "sessions": 0,
      "source": "工程经验，作者环境未命中（新规则，未上线）"
    },
    "selfTest": {
      "cases": [
        {
          "args": {
            "content": "# 报告\n\n## 结论\n\n[待补充]"
          },
          "expect": "block"
        },
        {
          "args": {
            "content": "# 报告\n\n## 结论\n\n三处要改，见下。"
          },
          "expect": "pass"
        },
        {
          "args": {
            "content": "模板里写 [待补充] 只是举例"
          },
          "expect": "pass"
        }
      ],
      "needFs": false
    },
    "scene": "写完报告直接发出去，正文里三个 [待补充] 原样留在那儿；对方打开先看见的是空白，而不是结论。"
  },
  {
    "id": "CORE-AI-TONE-01",
    "title": "写出来的东西满篇套话",
    "when": "tool:pre",
    "appliesTo": {
      "tool": "write",
      "fileMatches": "\\.(md|txt)$"
    },
    "condition": {
      "type": "regexHit",
      "in": "args.content",
      "pattern": "(综上所述|总而言之|显而易见地|毋庸置疑|赋能|抓手|形成闭环|深度融合|不仅.{0,24}而且.{0,24}更是)"
    },
    "action": "steer",
    "severity": "C",
    "message": "正文里有明显的套话句式，交给别人一眼就能看出不是人写的",
    "fix": "删掉套话，换成具体的事：谁做了什么、什么时候、结果是多少",
    "reversible": true,
    "evidence": {
      "hits": 0,
      "sessions": 0,
      "source": "工程经验，作者环境未命中（新规则，未上线）"
    },
    "selfTest": {
      "cases": [
        {
          "args": {
            "content": "综上所述，该方案具有重要意义。"
          },
          "expect": "block"
        },
        {
          "args": {
            "content": "这里有三处要改，第一处是第 12 行。"
          },
          "expect": "pass"
        },
        {
          "args": {
            "content": "这个功能起到了抓手作用，形成闭环。"
          },
          "expect": "block"
        }
      ],
      "needFs": false
    },
    "scene": "交上去的申报材料每段都用「首先、其次、最后」开头，全篇没有一个具体数字；评委翻两页就放下了。"
  },
  {
    "id": "CORE-PATH-LEAK-01",
    "title": "文件内容里带出本机会话号或内部路径",
    "when": "tool:pre",
    "appliesTo": {
      "tool": "write"
    },
    "condition": {
      "type": "regexHit",
      "in": "args.content",
      "pattern": "(sessions\\\\[0-9a-z-]{8,}|[0-9a-z]{8,10}-[0-9a-f]{16,}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|D:\\\\deepseek\\\\工作区\\\\[^\\\\]+)"
    },
    "action": "steer",
    "severity": "C",
    "message": "正文里带着本机的会话号或内部路径，对外发出去等于把自己的目录结构交出去",
    "fix": "把内部路径换成相对说法（「工作区里」「本地」），会话号删掉",
    "reversible": true,
    "evidence": {
      "hits": 0,
      "sessions": 0,
      "source": "工程经验，作者环境未命中（新规则，未上线）"
    },
    "selfTest": {
      "cases": [
        {
          "args": {
            "content": "这条是会话 0mwujld9i-7ac0bd81c968438ca81f5e9395 里改的"
          },
          "expect": "block"
        },
        {
          "args": {
            "content": "文件在 D:\\deepseek\\工作区\\弱裁判\\报告.md"
          },
          "expect": "block"
        },
        {
          "args": {
            "content": "结论：三处要改，见下。"
          },
          "expect": "pass"
        }
      ],
      "needFs": false
    },
    "scene": "对外发的说明文档里留着一句「见 D:\\deepseek\\工作区\\某会话\\输出.md」，收到的人既打不开也看不懂，还顺带知道了你的目录结构。"
  }
]
