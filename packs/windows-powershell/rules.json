          "pattern": "\\b(Remove-Item|ri|rm|del|erase|rd|rmdir)\\b\\s+(?:(?:-\\w+|/\\w+)\\s+)*(?:\"[\\$*]|'[\\$*]|\\$[A-Za-z_{(]|%[A-Za-z_][A-Za-z0-9_]*%|[^\\s;|]*\\*)"
        },
