          },
          "expect": "block"
        },
        {
          "args": {
            "command": "Remove-Item 'D:\\tmp\\old' -Recurse"
          },
          "expect": "pass"
        },
        {
          "args": {
            "command": "Remove-Item $p -Recurse -WhatIf"
          },
          "expect": "pass"
        },
        {
          "args": {
