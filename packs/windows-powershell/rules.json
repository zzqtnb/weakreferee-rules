[
  {
    "id": "WIN-ENC-01",
    "legacyJudge": "J8",
    "title": "写文本文件必须显式指定编码",
    "when": "tool:pre",
    "appliesTo": {
      "tool": "pwsh",
      "platform": [
        "windows"
      ],
      "shell": [
        "powershell-5.1"
      ]
    },
    "condition": {
      "all": [
        {
          "any": [
            {
              "type": "regexHit",
              "in": "args.command",
              "maskQuoted": false,
              "pattern": "(^|[^0-9*>=])>{1,2}\\s*(\"[^\"]+\\.(?:ps1|md|json|txt|csv|log|yml|yaml|xml|ini)\"|'[^']+\\.(?:ps1|md|json|txt|csv|log|yml|yaml|xml|ini)'|[^\\s|;&<>]+\\.(?:ps1|md|json|txt|csv|log|yml|yaml|xml|ini))"
            },
            {
              "type": "regexHit",
              "in": "args.command",
              "maskQuoted": true,
              "pattern": "\\b(Out-File|Set-Content|Add-Content|Export-Csv|Export-Clixml|Tee-Object)\\b"
            }
          ]
        },
        {
          "type": "regexMiss",
          "in": "args.command",
          "maskQuoted": true,
          "pattern": "-Encoding\\b"
        }
      ]
    },
    "action": "block",
    "severity": "S",
    "message": "写文本文件没带 -Encoding，中文会按默认编码落盘，读回来是乱码",
    "fix": "加 -Encoding utf8，或改用 [System.IO.File]::WriteAllText($p,$s,(New-Object System.Text.UTF8Encoding($true)))",
    "reversible": false,
    "evidence": {
      "hits": 29,
      "sessions": 16,
      "source": "作者环境拦记账本 / 作者环境回放记录",
      "whyRaw": "e-m-02：6 天记了 10 条、从未合并"
    },
    "selfTest": {
      "cases": [
        {
          "args": {
            "command": "Out-File -FilePath a.txt"
          },
          "expect": "block"
        },
        {
          "args": {
            "command": "Get-Content a.md > b.md"
          },
          "expect": "block"
        },
        {
          "args": {
            "command": "\"x\" | Set-Content c.json"
          },
          "expect": "block"
        },
        {
          "args": {
            "command": "Out-File -FilePath a.txt -Encoding utf8"
          },
          "expect": "pass"
        },
        {
          "args": {
            "command": "Select-String -Pattern 'Out-File|Set-Content'"
          },
          "expect": "pass"
        },
        {
          "args": {
            "command": "Get-ChildItem | Where-Object { $_.Name -like '*.json' }"
          },
          "expect": "pass"
        }
      ],
      "needFs": false
    },
    "scene": "导出文本时没写编码，中文落盘变成问号或乱码；当时看着成功，隔天再读才发现内容毁了。"
  },
  {
    "id": "WIN-AUTOVAR-CMD-01",
    "legacyJudge": "J17",
    "title": "命令行里不许给 PowerShell 自动变量赋值",
    "when": "tool:pre",
    "appliesTo": {
      "tool": "pwsh",
      "platform": [
        "windows"
      ],
      "shell": [
        "powershell-5.1"
      ]
    },
    "condition": {
      "type": "regexHit",
      "in": "args.command",
      "maskQuoted": true,
      "pattern": "\\$(input|args|error|host|home|pid|matches|this|foreach|psitem)\\s*=(?!=)"
    },
    "action": "block",
    "severity": "S",
    "message": "给 PowerShell 自动变量赋值（只读，或影响解析）",
    "fix": "换带固定前缀的多字名，如 $envPath 而不是 $home",
    "reversible": false,
    "evidence": {
      "hits": 12,
      "sessions": 11,
      "source": "作者环境拦记账本（累计命中见 hits）"
    },
    "selfTest": {
      "cases": [
        {
          "args": {
            "command": "$home = 'D:\\x'"
          },
          "expect": "block"
        },
        {
          "args": {
            "command": "$args = 1"
          },
          "expect": "block"
        },
        {
          "args": {
            "command": "$envPath = 'D:\\x'"
          },
          "expect": "pass"
        },
        {
          "args": {
            "command": "Write-Output '$home = 1'"
          },
          "expect": "pass"
        }
      ],
      "needFs": false
    },
    "scene": "命令行里给 $home 这类保留名赋值，整条命令当场失效，报错信息完全看不出跟赋值有关，来回改别的部分浪费很久。"
  },
  {
    "id": "WIN-PS1-AUTOVAR-01",
    "legacyJudge": "J10",
    "title": "往 .ps1 里写自动变量赋值",
